#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "DS Install: $1" >&2
  osascript -e "display dialog \"DS Install failed:\n\n$1\" buttons {\"OK\"} default button \"OK\" with icon stop" 2>/dev/null || true
  exit 1
}

if ! command -v node &>/dev/null; then
  fail "Node.js is required but not installed.\n\nDownload it from https://nodejs.org and run the DS installer again."
fi

if ! command -v claude &>/dev/null; then
  fail "Claude Code CLI is required but not installed.\n\nInstall it from https://claude.ai/code and run the DS installer again."
fi

exit 0
